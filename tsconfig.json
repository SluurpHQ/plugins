{
  "//": "Sluurp's types for editors: `sluurp types` writes .sluurp/ (not committed), as a served app gets it.",
  "extends": "./.sluurp/tsconfig.json",
  "include": [
    "types/*.d.ts",
    "*/**/*.ts",
    "*/**/*.tsx",
    ".sluurp/types/sluurp-global.d.ts",
    ".sluurp/types/sluurp-server.d.ts",
    ".sluurp/types/vendored.d.ts"
  ],
  "exclude": [".sluurp/client", ".sluurp/vendored", "node_modules"]
}
